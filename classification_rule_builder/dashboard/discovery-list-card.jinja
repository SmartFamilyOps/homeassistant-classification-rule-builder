{# SmartFamilyOps managed discovery list #}
{% from 'smartfamilyops_device_catalogue.jinja' import dashboard_devices -%}
{% set dashboard_devices_fn = dashboard_devices | as_function -%}
{% set catalogued_devices = dashboard_devices_fn('__DASHBOARD_ID__') -%}
{% set rows = namespace(text='| # | Online | Device | Location | Manufacturer | Function |\n|--:|:--:|:--|:--|:--|:--|') -%}
{% for d in catalogued_devices -%}
  {% set available = namespace(value=false) -%}
  {% for entity_id in d.relevant_entity_ids -%}
    {% set state = states[entity_id] -%}
    {% if state is not none and state.state | lower not in ['unknown', 'unavailable', 'none', ''] -%}{% set available.value = true %}{% endif -%}
  {% endfor -%}
  {% set name = device_name(d.device_id) | default(d.name, true) -%}
  {% set area = area_name(d.device_id) | default(d.area, true) -%}
  {% set manufacturer = device_attr(d.device_id, 'manufacturer') | default(d.manufacturer, true) -%}
  {% set status = '✅' if available.value else '❌' -%}
  {% set rows.text = rows.text ~ '\n| ' ~ loop.index ~ ' | ' ~ status ~ ' | **' ~ name ~ '** | ' ~ area ~ ' | ' ~ manufacturer ~ ' | ' ~ d.function ~ ' |' -%}
{% endfor -%}
# __DASHBOARD_TITLE__

{{ rows.text }}
