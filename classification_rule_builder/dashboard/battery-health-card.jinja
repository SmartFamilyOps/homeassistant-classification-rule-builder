# 🛡️ SmartFamily Ops
## Battery & Power Observability
_Protected device telemetry • power-source discovery • Splunk test catalogue_

{% from 'smartfamilyops_device_catalogue.jinja' import battery_health_devices -%}
{% set battery_health_devices_fn = battery_health_devices | as_function -%}
{% set catalogued_devices = battery_health_devices_fn() -%}

{# PRESENTATION: membership and classification were evaluated when the catalogue was published. #}
{% set batteries = namespace(items=[]) -%}
{% for d in catalogued_devices -%}
  {% set battery_state = states[d.battery_entity_id] if d.battery_entity_id else none -%}
  {% set raw_level = (battery_state.state | lower) if battery_state is not none else '' -%}
  {% set numeric_level = (battery_state.state | float(999)) if battery_state is not none else 999 -%}
  {% set level_valid = raw_level not in ['unknown','unavailable','none',''] and numeric_level >= 0 and numeric_level <= 100 -%}
  {% set battery_display = ((numeric_level | round(0) | int) ~ '%') if level_valid else '' -%}
  {% set sort_level = (numeric_level | round(0) | int) if level_valid else 999 -%}
  {% if not level_valid -%}
    {% set battery_icon = 'mdi:battery-unknown' -%}
  {% elif numeric_level < 10 -%}
    {% set battery_icon = 'mdi:battery-outline' -%}
  {% elif numeric_level < 20 -%}
    {% set battery_icon = 'mdi:battery-10' -%}
  {% elif numeric_level < 30 -%}
    {% set battery_icon = 'mdi:battery-20' -%}
  {% elif numeric_level < 40 -%}
    {% set battery_icon = 'mdi:battery-30' -%}
  {% elif numeric_level < 50 -%}
    {% set battery_icon = 'mdi:battery-40' -%}
  {% elif numeric_level < 60 -%}
    {% set battery_icon = 'mdi:battery-50' -%}
  {% elif numeric_level < 70 -%}
    {% set battery_icon = 'mdi:battery-60' -%}
  {% elif numeric_level < 80 -%}
    {% set battery_icon = 'mdi:battery-70' -%}
  {% elif numeric_level < 90 -%}
    {% set battery_icon = 'mdi:battery-80' -%}
  {% elif numeric_level < 100 -%}
    {% set battery_icon = 'mdi:battery-90' -%}
  {% else -%}
    {% set battery_icon = 'mdi:battery' -%}
  {% endif -%}

  {% set p = namespace(charging='Unknown', wired='Unknown', mode='Unknown', battery_temperature='Unknown', evidence=[], available_count=0, unavailable_count=0) -%}
  {% for e in d.relevant_entity_ids -%}
    {% set es = states[e] -%}
    {% if es is not none and es.state | lower not in ['unknown','unavailable','none',''] -%}
      {% set p.available_count = p.available_count + 1 -%}
    {% else -%}
      {% set p.unavailable_count = p.unavailable_count + 1 -%}
    {% endif -%}
  {% endfor -%}
  {% for e in d.entity_ids -%}
    {% set es = states[e] -%}
    {% if es is not none -%}
      {% set hint = (es.name ~ ' ' ~ e ~ ' ' ~ es.state) | lower -%}
      {% if 'battery temperature' in hint and es.state | lower not in ['unknown','unavailable','none',''] -%}
        {% set p.battery_temperature = es.state ~ (es.attributes.get('unit_of_measurement') or '') -%}
      {% endif -%}
      {% if 'charg' in hint or 'power' in hint or 'plug' in hint or 'wired' in hint or 'mains' in hint or 'ac ' in hint or 'usb' in hint -%}
        {% set p.evidence = p.evidence + [es.name ~ ': ' ~ es.state] -%}
        {% if 'charg' in hint and es.state | lower in ['on','true','charging'] %}{% set p.charging = 'Yes' %}{% set p.mode = 'Charging' %}{% endif -%}
        {% if 'charg' in hint and es.state | lower in ['off','false','not charging'] %}{% set p.charging = 'No' %}{% endif -%}
        {% if ('wired' in hint or 'mains' in hint or 'plug' in hint or 'usb' in hint or 'ac ' in hint) and es.state | lower not in ['off','false','unknown','unavailable'] %}{% set p.wired = 'Likely' %}{% set p.mode = 'External power' %}{% endif -%}
        {% if 'discharg' in hint %}{% set p.mode = 'Battery' %}{% endif -%}
      {% endif -%}
    {% endif -%}
  {% endfor -%}
  {% set ha_status = 'Online' if p.available_count > 0 else 'Offline' -%}
  {% set ha_status_display = '✅' if p.available_count > 0 else '❌' -%}
  {% set availability_evidence = p.available_count ~ ' available / ' ~ p.unavailable_count ~ ' unavailable' -%}
  {% set batteries.items = batteries.items + [{'device_id': d.device_id, 'entity_id': d.battery_entity_id, 'name': d.name, 'area': d.area, 'manufacturer': d.manufacturer, 'function': d.function, 'classification': d.classification, 'level': battery_display, 'sort_level': sort_level, 'battery_icon': battery_icon, 'ha_status': ha_status, 'ha_status_display': ha_status_display, 'availability_evidence': availability_evidence, 'charging': p.charging, 'wired': p.wired, 'mode': p.mode, 'battery_temperature': p.battery_temperature, 'evidence': p.evidence | join('; ')}] -%}
{% endfor -%}

{% set table = namespace(text='| # | Online | Battery | Device | Location | Manufacturer | Function | Splunk test |\n|--:|:--:|:--|:--|:--|:--|:--|:--|') -%}
{% for i in batteries.items | sort(attribute='sort_level') -%}
{% set configure_url = '/local/smartfamilyops/splunk-onboarding.html?device_id=' ~ (i.device_id | urlencode) ~ '&entity_id=' ~ (i.entity_id | urlencode) ~ '&device_name=' ~ (i.name | urlencode) ~ '&location=' ~ (i.area | urlencode) ~ '&manufacturer=' ~ (i.manufacturer | urlencode) ~ '&function=' ~ (i.function | urlencode) ~ '&ha_status=' ~ (i.ha_status | urlencode) ~ '&availability_evidence=' ~ (i.availability_evidence | urlencode) ~ '&classification=' ~ (i.classification | urlencode) ~ '&battery=' ~ (i.level | urlencode) ~ '&battery_temperature=' ~ (i.battery_temperature | urlencode) ~ '&charging=' ~ (i.charging | urlencode) ~ '&wired_power=' ~ (i.wired | urlencode) ~ '&current_mode=' ~ (i.mode | urlencode) ~ '&entity_evidence=' ~ (i.evidence | urlencode) ~ '&suggested_test=' ~ ('Battery + power + temperature' | urlencode) -%}
{% set battery_cell = '<font color="#2196f3"><ha-icon icon="' ~ i.battery_icon ~ '"></ha-icon></font>' ~ ((' <strong>' ~ i.level ~ '</strong>') if i.level else '') -%}
{% if i.entity_id -%}{% set battery_cell = '<abbr title="Source entity: ' ~ i.entity_id ~ '">' ~ battery_cell ~ '</abbr>' -%}{% endif -%}
{% set table.text = table.text ~ '\n| ' ~ loop.index ~ ' | <strong>' ~ i.ha_status_display ~ '</strong> | ' ~ battery_cell ~ ' | <abbr title="Home Assistant device registry value for device: ' ~ i.device_id ~ '"><strong>' ~ i.name ~ '</strong></abbr> | <abbr title="Home Assistant area registry value for device: ' ~ i.device_id ~ '">' ~ i.area ~ '</abbr> | <abbr title="Home Assistant device registry value for device: ' ~ i.device_id ~ '">' ~ i.manufacturer ~ '</abbr> | ' ~ i.function ~ ' | <a href="' ~ configure_url ~ '" target="_blank" rel="noopener noreferrer">Configure</a> |' -%}
{% endfor -%}
{{- '\n\n' ~ table.text ~ '\n\n' -}}

**Home Assistant status:** ✅ Online means at least one relevant stateful entity has a usable state. ❌ Offline means none of the relevant entities has a usable state. The published device catalogue keeps offline devices visible. Refresh discovery and publish in Dashboard Builder when registered devices or entities change.

**Interpretation:** Dashboard membership and function are evaluated by the published SmartFamilyOps classification catalogue. Current battery, power and availability values are read from Home Assistant at display time.
